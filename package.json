{
  "name": "campuscare-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Student mental health early-warning, case management and telehealth platform (Phase 1 MVP).",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migration:init": "prisma migrate diff --from-empty --to-schema prisma/schema.prisma --script",
    "db:reset": "tsx scripts/db-reset.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@phosphor-icons/react": "2.1.10",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "geist": "1.9.2",
    "next": "16.4.6",
    "pg": "^8.16.0",
    "pglite-prisma-adapter": "0.7.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/pg": "^8.15.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.2.0",
    "dotenv": "^17.2.0",
    "postcss": "^8.5.6",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
