# Copy to .env and fill in. Never commit real values.

# The one MongoDB Atlas database, shared by the live site and local development: anything you
# change locally appears on the live demo. MONGODB_URI is read when DATABASE_URL is unset.
DATABASE_URL="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/campuscare?retryWrites=true&w=majority&maxPoolSize=5"

# 32 random bytes, base64. Encrypts check-in notes, messages, help details and clinical notes.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=""

# Shared secret for the scheduled /api/internal/tick endpoint (reminders, escalation re-checks).
CRON_SECRET=""

# What this site is: "demo", "pilot" or "production". Only "demo" turns on the one-click demo
# personas on /sign-in and the demo notice, and only "demo" lets db:seed and db:reset run.
# Unset, empty or anything else means demo mode is off.
CAMPUSCARE_DEPLOYMENT=""

# The address behind the "Request a pilot" buttons on the landing page. One plain address on a
# real domain. Leave empty and the buttons are not shown. On Vercel a change needs a redeploy.
PILOT_CONTACT_EMAIL=""

# Video provider for consultations: "dev" (local waiting room, no media relay) or "daily".
VIDEO_PROVIDER="dev"
# DAILY_API_KEY=""
# DAILY_DOMAIN="your-team.daily.co"

APP_ORIGIN="http://localhost:3000"
